# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://getthursdai.com

# ── PostHog analytics + feature flags ─────────────────────────────────────────
# Get from posthog.com → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=phc_XXXX
# Browser events go here (cookieless, see src/lib/analytics.ts); the CSP connect-src is built from it.
# US cloud: https://us.i.posthog.com (default when unset). EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side key for hero A/B test flag evaluation (never expose to browser)
POSTHOG_PERSONAL_API_KEY=phx_XXXX

# ── HubSpot (demo request form) ────────────────────────────────────────────────
# Settings → Integrations → API Key
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
# Private app token (scopes: forms, contacts)
HUBSPOT_ACCESS_TOKEN=

# ── Sentry error tracking ──────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Coming-soon preview bypass (only matters while COMING_SOON is true in middleware) ──
# Unset means no bypass exists. Generate a fresh value; never reuse one that was committed.
PREVIEW_BYPASS_SECRET=

# ── Vercel deployment ──────────────────────────────────────────────────────────
# Set in GitHub repo secrets (never in .env files)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ── Lighthouse CI ─────────────────────────────────────────────────────────────
# Set in GitHub repo secrets
# LHCI_GITHUB_APP_TOKEN=
